# ---- Free LLM providers (set at least one) ----
# Groq:       https://console.groq.com/keys
GROQ_API_KEY=
# Gemini:     https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys  (use ":free" models)
OPENROUTER_API_KEY=
# Ollama (fully local, optional): leave blank to disable
OLLAMA_BASE_URL=

# ---- Optional search provider (free tier). Falls back to ddgs metasearch (DuckDuckGo/Bing/Brave/...) then Wikipedia. ----
TAVILY_API_KEY=

# ---- Role -> model routing. Comma-separated fallback chain, "provider:model". ----
# Providers without a key are skipped automatically.
MODEL_PLANNER=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,openrouter:nvidia/nemotron-3.5-super-vl:free
MODEL_FAST=groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b
MODEL_WRITER=gemini:gemini-3.5-flash,gemini:gemini-2.5-flash,groq:openai/gpt-oss-120b
MODEL_CRITIC=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-2.5-flash
MODEL_ANALYST=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash
# LLM-as-judge used by the evaluation metrics (faithfulness, context precision, answer relevance)
MODEL_JUDGE=groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# ---- Orchestration ----
MAX_REVISIONS=2
PASS_SCORE=8.0
SEARCH_RESULTS_PER_QUERY=5
MAX_SOURCES=18

# ---- Auth ----
# The admin account is created on first start. Pick a strong password; you can change it later in the Admin console.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# SESSION_DAYS=14
# GUEST_HOURS=24
# GUESTS_PER_IP_PER_DAY=5
# COOKIE_SECURE=false   # set true when served over HTTPS

# ---- Production / deployment (see docs/DEPLOYMENT.md) ----
# Where SQLite DBs, uploads and charts live (default: backend/data). The Docker image uses /data.
# DATA_DIR=
# Signs live-stream tokens. Set a stable random value in production: openssl rand -hex 32
SECRET_KEY=
# Origins allowed to open the live event stream directly (comma-separated, or *)
CORS_ORIGINS=*
# true only behind trusted proxies (Vercel + Cloudflare): per-IP limits then use X-Forwarded-For
# TRUST_PROXY=false
